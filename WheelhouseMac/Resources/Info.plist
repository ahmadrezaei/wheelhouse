<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wheelhouse</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Kubeconfig</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.yaml</string>
				<string>com.ahmadrezaei.wheelhouse.kubeconfig</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Wheelhouse Station</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ahmadrezaei.wheelhouse.station</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MAC_MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ahmadrezaei.wheelhouse.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wheelhouse</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(MAC_BUILD_NUMBER)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>27.0</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Wheelhouse connects to clusters and Prometheus servers on your local network.</string>
	<key>SUEnableAutomaticChecks</key>
	<string>$(WH_SU_AUTO_CHECKS)</string>
	<key>SUFeedURL</key>
	<string>$(WH_SU_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(WH_SU_PUBLIC_ED_KEY)</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUShowReleaseNotes</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.yaml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Kubernetes kubeconfig</string>
			<key>UTTypeIdentifier</key>
			<string>com.ahmadrezaei.wheelhouse.kubeconfig</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kubeconfig</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Wheelhouse Station</string>
			<key>UTTypeIdentifier</key>
			<string>com.ahmadrezaei.wheelhouse.station</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>whstation</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>WHAppGroup</key>
	<string>$(WH_APP_GROUP)</string>
	<key>WHDefaultTestKubeconfig</key>
	<string>$(WH_DEFAULT_TEST_KUBECONFIG)</string>
	<key>WHDevSafety</key>
	<string>$(WH_DEV_SAFETY)</string>
	<key>WHKeychainGroupSuffix</key>
	<string>$(WH_KEYCHAIN_GROUP_SUFFIX)</string>
	<key>WHKeychainPrivateGroupSuffix</key>
	<string>$(WH_KEYCHAIN_PRIVATE_GROUP_SUFFIX)</string>
	<key>WHPerfScenarioDirectory</key>
	<string>$(WH_PERF_SCENARIOS)</string>
</dict>
</plist>
